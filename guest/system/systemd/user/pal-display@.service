# One X display (Xvnc + xfce4 session) per owner: a bot id or "operator".
#
# The unit runs in the slice pal-display-<owner>.slice, together with every
# program launched onto the display with pal-open. The runtime starts this
# unit on demand and freezes, thaws, and stops the slice: freezing suspends
# the X server, the desktop, and the owner's applications together, which is
# how a display "sleeps" without losing its windows.

[Unit]
Description=Pal display for %i

[Service]
Type=simple
Slice=pal-display-%i.slice
EnvironmentFile=%h/.config/pal/displays/%i.env
ExecStart=/opt/pal/bin/pal-display-session
ExecStop=/opt/pal/bin/pal-display-save
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=20

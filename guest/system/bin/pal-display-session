#!/usr/bin/env bash
# Start one Pal display: an Xvnc server and an xfce4 session on it.
#
# Reads its settings from the environment (written by the runtime):
#   PAL_DISPLAY_NUMBER    X display number, e.g. 10 for :10
#   PAL_VNC_PORT          localhost port for the VNC server
#   PAL_DISPLAY_GEOMETRY  e.g. 1280x800
#   PAL_DISPLAY_DEPTH     e.g. 24
#   PAL_DISPLAY_OWNER     bot id or "operator"
set -euo pipefail

: "${PAL_DISPLAY_NUMBER:?PAL_DISPLAY_NUMBER is not set}"
: "${PAL_VNC_PORT:?PAL_VNC_PORT is not set}"
number=$PAL_DISPLAY_NUMBER
display=":$number"
owner=${PAL_DISPLAY_OWNER:-display$number}
password_file=${PAL_VNC_PASSWORD_FILE:-$HOME/.config/pal/secrets/vnc-passwd}
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
bus_file="$runtime_dir/pal-display-$number.bus"

# Clipboard sharing is off: a viewer would otherwise push the host's
# clipboard into the VM whenever it changes.

# A reboot or crash can leave a stale lock behind; remove it only when the
# process that owned it is gone.
lock="/tmp/.X$number-lock"
if [[ -f $lock ]]; then
    pid=$(tr -d ' ' <"$lock" || true)
    if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$lock" "/tmp/.X11-unix/X$number"
    fi
fi

# Only the readiness check below may talk to systemd: the session bus
# daemon would otherwise report the display ready the moment it starts.
notify_socket=${NOTIFY_SOCKET:-}
unset NOTIFY_SOCKET

Xvnc "$display" \
    -geometry "${PAL_DISPLAY_GEOMETRY:-1280x800}" \
    -depth "${PAL_DISPLAY_DEPTH:-24}" \
    -rfbport "$PAL_VNC_PORT" \
    -localhost \
    -SecurityTypes VncAuth \
    -PasswordFile "$password_file" \
    -AlwaysShared \
    -AcceptCutText=0 \
    -SendCutText=0 \
    -SendPrimary=0 \
    -AcceptSetDesktopSize \
    -desktop "Pal - $owner" \
    -nolisten tcp &

for _ in $(seq 1 100); do
    [[ -S /tmp/.X11-unix/X$number ]] && break
    sleep 0.1
done
[[ -S /tmp/.X11-unix/X$number ]] || { echo "Xvnc did not start on $display" >&2; exit 1; }

export DISPLAY=$display
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=XFCE
export PAL_DISPLAY_OWNER=$owner

# A display is a workspace for an agent: never blank or lock it.
xset s off -dpms 2>/dev/null || true

# Report the display ready once a window manager manages it, so whatever
# started it can open windows straight away (gives up waiting after 20s), then
# reopen the windows that were open when the display last turned off.
(
    for _ in $(seq 1 200); do
        wmctrl -l >/dev/null 2>&1 && break
        sleep 0.1
    done
    NOTIFY_SOCKET=$notify_socket systemd-notify --ready
    /opt/pal/bin/pal-windows restore || true
) &

# Each display gets a private session bus, recorded so that programs opened
# with pal-open use it (and each display can run its own copy of a program).
exec dbus-run-session -- bash -c '
    printf "%s\n" "$DBUS_SESSION_BUS_ADDRESS" >"$1"
    /opt/pal/bin/pal-desktop-defaults || true
    exec xfce4-session
' pal-display "$bus_file"
